{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-bootstrap",
        "server": "1.1.1.1"
      },
      {
        "type": "https",
        "tag": "dns-local",
        "server": "1.1.1.1"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "PILIH-PROXY"
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "PILIH-PROXY",
      "outbounds": [
        "AUTO-TERCEPAT",
        "DIRECT",
        "==DAFTAR_SEMUA_TAG_PROXY=="
      ],
      "default": "AUTO-TERCEPAT"
    },
    {
      "type": "urltest",
      "tag": "AUTO-TERCEPAT",
      "outbounds": [
        "==DAFTAR_SEMUA_TAG_PROXY=="
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "DIRECT"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT"
      }
    ],
    "final": "PILIH-PROXY",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-bootstrap"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    }
  }
}
